        "import unittest\n",
        "\n",
        "# =====================================================================\n",
        "# PART 1: ATM SYSTEM IMPLEMENTATION\n",
        "# =====================================================================\n",
        "\n",
        "class ATMSystem:\n",
        "    \"\"\"\n",
        "    Simulates ATM core banking functionality, enforcing validation rules\n",
        "    and transaction constraints.\n",
        "    \"\"\"\n",
        "    def __init__(self):\n",
        "        self.card_database = {\n",
        "            \"CARD_VALID_101\": {\n",
        "                \"pin\": \"1234\",\n",
        "                \"accounts\": {\n",
        "                    \"Savings\": 25000.0,\n",
        "                    \"Current\": 50000.0\n",
        "                },\n",
        "                \"daily_withdrawn\": 0.0\n",
        "            }\n",
        "        }\n",
        "        self.PER_TRANSACTION_LIMIT = 20000.0\n",
        "        self.DAILY_WITHDRAWAL_LIMIT = 40000.0\n",
        "\n",
        "    def validate_card(self, card_number: str) -> str:\n",
        "        if card_number in self.card_database:\n",
        "            return \"Welcome Screen\"\n",
        "        return \"Invalid card\"\n",
        "\n",
        "    def authenticate_pin(self, card_number: str, pin: str) -> str:\n",
        "        if card_number in self.card_database:\n",
        "            if self.card_database[card_number][\"pin\"] == pin:\n",
        "                return \"Menu screen displayed\"\n",
        "        return \"Invalid PIN screen is displayed\"\n",
        "\n",
        "    def select_account_type(self, card_number: str, account_type: str) -> str:\n",
        "        if card_number in self.card_database:\n",
        "            if account_type in self.card_database[card_number][\"accounts\"]:\n",
        "                return \"Enter the Amount screen displayed\"\n",
        "        return \"Invalid Account type screen is displayed\"\n",
        "\n",
        "    def withdraw_cash(self, card_number: str, account_type: str, amount: float) -> dict:\n",
        "        user_data = self.card_database.get(card_number)\n",
        "\n",
        "        # 1. Check Denomination\n",
        "        if amount % 100 != 0 or amount <= 0:\n",
        "            return {\n",
        "                \"result\": \"Amount enter not in required denominations\",\n",
        "                \"receipt_printed\": False\n",
        "            }\n",
        "\n",
        "        # 2. Check Per-Transaction Limit\n",
        "        if amount > self.PER_TRANSACTION_LIMIT:\n",
        "            return {\n",
        "                \"result\": \"Transaction limit exceeded screen is displayed\",\n",
        "                \"receipt_printed\": False\n",
        "            }\n",
        "\n",
        "        # 3. Check Daily Limit\n",
        "        if user_data[\"daily_withdrawn\"] + amount > self.DAILY_WITHDRAWAL_LIMIT:\n",
        "            return {\n",
        "                \"result\": \"Day limit exceeded screen is displayed\",\n",
        "                \"receipt_printed\": False\n",
        "            }\n",
        "\n",
        "        # 4. Check Available Account Balance\n",
        "        if amount > user_data[\"accounts\"][account_type]:\n",
        "            return {\n",
        "                \"result\": \"Insufficient balance in the account\",\n",
        "                \"receipt_printed\": False\n",
        "            }\n",
        "\n",
        "        # Process successful transaction\n",
        "        user_data[\"accounts\"][account_type] -= amount\n",
        "        user_data[\"daily_withdrawn\"] += amount\n",
        "\n",
        "        return {\n",
        "            \"result\": \"Collect the amount screen displayed\",\n",
        "            \"receipt_printed\": True\n",
        "        }\n",
        "\n",
        "    def change_pin(self, card_number: str, old_pin: str, new_pin: str, confirm_pin: str) -> str:\n",
        "        auth_status = self.authenticate_pin(card_number, old_pin)\n",
        "        if auth_status != \"Menu screen displayed\":\n",
        "            return \"Invalid PIN screen is displayed\"\n",
        "\n",
        "        if new_pin != confirm_pin:\n",
        "            return \"PIN mismatch screen displayed\"\n",
        "\n",
        "        self.card_database[card_number][\"pin\"] = new_pin\n",
        "        return \"PIN changed successfully screen displayed\"\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# PART 2: AUTOMATED TEST SUITE & BUG REPORT GENERATOR\n",
        "# =====================================================================\n",
        "\n",
        "class TestATMSystem(unittest.TestCase):\n",
        "\n",
        "    def setUp(self):\n",
        "        self.atm = ATMSystem()\n",
        "        self.valid_card = \"CARD_VALID_101\"\n",
        "        self.invalid_card = \"CARD_INVALID_999\"\n",
        "        self.valid_pin = \"1234\"\n",
        "        self.invalid_pin = \"0000\"\n",
        "\n",
        "    def run_bug_test(self, bug_id, bug_name, steps, expected, actual):\n",
        "        status = \"PASS\" if expected == actual else \"FAIL\"\n",
        "        print(f\"\\n{'='*60}\")\n",
        "        print(f\"Bug Id          : {bug_id}\")\n",
        "        print(f\"Bug Name        : {bug_name}\")\n",
        "        print(f\"Steps           : {steps}\")\n",
        "        print(f\"Expected Result : {expected}\")\n",
        "        print(f\"Actual Result   : {actual}\")\n",
        "        print(f\"Status          : {status}\")\n",
        "        print(f\"{'='*60}\")\n",
        "        self.assertEqual(expected, actual)\n",
        "\n",
        "    def test_ATM_001_invalid_card(self):\n",
        "        actual = self.atm.validate_card(self.invalid_card)\n",
        "        expected = \"Invalid card\"\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 001\",\n",
        "            bug_name=\"Invalid Card\",\n",
        "            steps=\"Insert invalid card into ATM.\",\n",
        "            expected=expected,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "    def test_ATM_002_invalid_pin(self):\n",
        "        actual = self.atm.authenticate_pin(self.valid_card, self.invalid_pin)\n",
        "        expected = \"Invalid PIN screen is displayed\"\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 002\",\n",
        "            bug_name=\"Invalid PIN\",\n",
        "            steps=\"Insert valid card -> Enter incorrect PIN.\",\n",
        "            expected=expected,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "    def test_ATM_003_invalid_account_type(self):\n",
        "        actual = self.atm.select_account_type(self.valid_card, \"Demat Account\")\n",
        "        expected = \"Invalid Account type screen is displayed\"\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 003\",\n",
        "            bug_name=\"Invalid Account Type\",\n",
        "            steps=\"Insert valid card -> Enter PIN -> Choose non-existent account type.\",\n",
        "            expected=expected,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "    def test_ATM_004_insufficient_balance(self):\n",
        "        \"\"\"Test ATM 004: Withdrawal exceeding available balance\"\"\"\n",
        "        # Set balance to 15,000 so requesting 18,000 stays within transaction limit (20,000)\n",
        "        self.atm.card_database[self.valid_card][\"accounts\"][\"Savings\"] = 15000.0\n",
        "        response = self.atm.withdraw_cash(self.valid_card, \"Savings\", 18000.0)\n",
        "        actual = response[\"result\"]\n",
        "        expected = \"Insufficient balance in the account\"\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 004\",\n",
        "            bug_name=\"Insufficient Balance\",\n",
        "            steps=\"Select Savings -> Request withdrawal of 18,000 (Balance: 15,000, Txn Limit: 20,000).\",\n",
        "            expected=expected,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "    def test_ATM_005_transaction_limit(self):\n",
        "        actual_response = self.atm.withdraw_cash(self.valid_card, \"Current\", 25000.0)\n",
        "        actual = actual_response[\"result\"]\n",
        "        expected = \"Transaction limit exceeded screen is displayed\"\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 005\",\n",
        "            bug_name=\"Transaction Limit\",\n",
        "            steps=\"Request withdrawal of 25,000 (Limit per transaction: 20,000).\",\n",
        "            expected=expected,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "    def test_ATM_006_day_limit(self):\n",
        "        self.atm.withdraw_cash(self.valid_card, \"Current\", 20000.0)\n",
        "        self.atm.withdraw_cash(self.valid_card, \"Current\", 20000.0)\n",
        "        response = self.atm.withdraw_cash(self.valid_card, \"Current\", 5000.0)\n",
        "        actual = response[\"result\"]\n",
        "        expected = \"Day limit exceeded screen is displayed\"\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 006\",\n",
        "            bug_name=\"Day Limit Exceeded\",\n",
        "            steps=\"Attempt total daily withdrawals exceeding 40,000.\",\n",
        "            expected=expected,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "    def test_ATM_007_invalid_denominations(self):\n",
        "        response = self.atm.withdraw_cash(self.valid_card, \"Savings\", 550.0)\n",
        "        actual = response[\"result\"]\n",
        "        expected = \"Amount enter not in required denominations\"\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 007\",\n",
        "            bug_name=\"Invalid Money Denominations\",\n",
        "            steps=\"Enter amount 550 (not a multiple of 100).\",\n",
        "            expected=expected,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "    def test_ATM_008_receipt_printing(self):\n",
        "        response = self.atm.withdraw_cash(self.valid_card, \"Savings\", 5000.0)\n",
        "        actual = response[\"receipt_printed\"]\n",
        "        expected = True\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 008\",\n",
        "            bug_name=\"Receipt Printed\",\n",
        "            steps=\"Execute valid withdrawal of 5,000 -> Check receipt printing.\",\n",
        "            expected=True,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "    def test_ATM_009_pin_change_mismatch(self):\n",
        "        actual = self.atm.change_pin(self.valid_card, \"1234\", \"5678\", \"9999\")\n",
        "        expected = \"PIN mismatch screen displayed\"\n",
        "        self.run_bug_test(\n",
        "            bug_id=\"ATM 009\",\n",
        "            bug_name=\"PIN Change Mismatch\",\n",
        "            steps=\"Enter new PIN '5678' and confirm PIN '9999'.\",\n",
        "            expected=expected,\n",
        "            actual=actual\n",
        "        )\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# PART 3: COLAB-COMPATIBLE TEST RUNNER\n",
        "# =====================================================================\n",
        "if __name__ == \"__main__\":\n",
        "    print(\"\\nExecuting Software Testing Lab - Experiment 1: ATM System Test Suite\\n\")\n",
        "    unittest.main(argv=[''], exit=False)"
      ]
